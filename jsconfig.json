{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"],
            "@app/*": ["./src/app/*"],
            "@canvas/*": ["./src/canvas/*"],
            "@components/*": ["./src/components/*"],
            "@config/*": ["./src/config/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@routes/*": ["./src/routes/*"],
            "@utils/*": ["./src/utils/*"]
        },
        "checkJs": false
    },
    "include": ["src"]
}
